   function uid(){ try{ if(crypto && crypto.randomUUID) return crypto.randomUUID(); }catch(e){} return 'id_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36); }
 
+  // Payment history has its own unique sequence, independent from installment number.
+  // Older versions used `seq` as the installment number, which could legitimately repeat.
+  function ensureLoanHistoryPaymentNumbers(l){
+    if(!l || !Array.isArray(l.history) || !l.history.length) return false;
+    let changed=false;
+    const used=new Set();
+    const pending=[];
+    l.history.forEach((h,idx)=>{
+      const n=Number(faToEn(String(h.paymentNo||'')));
+      if(Number.isInteger(n) && n>0 && !used.has(n)){ h.paymentNo=n; used.add(n); }
+      else { pending.push({h,idx}); if(h.paymentNo!=null) changed=true; }
+      if(h.installmentSeq==null && h.seq!=null){ h.installmentSeq=h.seq; changed=true; }
+    });
+    pending.sort((a,b)=>{
+      const ka=dateTimeSortKey(a.h.date,a.h.time), kb=dateTimeSortKey(b.h.date,b.h.time);
+      return ka===kb ? a.idx-b.idx : ka-kb;
+    });
+    let next=1;
+    pending.forEach(({h})=>{
+      while(used.has(next)) next++;
+      h.paymentNo=next; used.add(next); next++; changed=true;
+    });
+    return changed;
+  }
+  function nextLoanPaymentNo(l){
+    ensureLoanHistoryPaymentNumbers(l);
+    return (l.history||[]).reduce((m,h)=>Math.max(m,Number(h.paymentNo)||0),0)+1;
+  }
+  (function migratePaymentHistoryNumbers(){
+    let changed=false;
+    (state.loans||[]).forEach(l=>{ if(ensureLoanHistoryPaymentNumbers(l)) changed=true; });
+    if(changed){ try{ localStorage.setItem(STORE_KEY,JSON.stringify(state)); }catch(e){} }
+  })();
+
