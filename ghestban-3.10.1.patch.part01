+  function normalizedScheduleItem(raw, fallbackSeq, fallbackAmount){
+    raw = raw && typeof raw === 'object' ? raw : {};
+    return {
+      id: raw.id || uid(),
+      seq: Math.max(Number(raw.seq) || fallbackSeq || 1, 1),
+      dueDate: String(raw.dueDate || '').trim(),
+      amount: Math.max(Number(raw.amount) || Number(fallbackAmount) || 0, 0),
+      paymentId: String(raw.paymentId || raw.paymentIdentifier || '').trim(),
+      paid: !!raw.paid,
+      paidAt: String(raw.paidAt || '').trim(),
+      paidTime: String(raw.paidTime || '').trim(),
+      tracking: String(raw.tracking || '').trim(),
+      method: String(raw.method || '').trim(),
+      note: String(raw.note || '').trim()
+    };
+  }
+  function getLoanSchedule(l){
+    return Array.isArray(l && l.schedule) ? l.schedule.map((x,i)=>normalizedScheduleItem(x,i+1,l.amount)).sort((a,b)=>a.seq-b.seq) : [];
+  }
+  function syncLoanFromSchedule(l){
+    const schedule=getLoanSchedule(l);
+    if(!schedule.length) return l;
+    l.schedule=schedule;
+    l.total=schedule.length;
+    l.paid=schedule.filter(x=>x.paid).length;
+    const paidDates=schedule.filter(x=>x.paid&&x.paidAt).map(x=>x.paidAt).sort((a,b)=>dateTimeSortKey(b)-dateTimeSortKey(a));
+    if(paidDates.length) l.lastPay=paidDates[0];
+    const next=schedule.find(x=>!x.paid);
+    l.dueDate=next ? (next.dueDate||'') : '';
+    if(next && next.amount) l.amount=Number(next.amount)||l.amount;
+    return l;
+  }
+  function nextUnpaidInstallment(l){ return getLoanSchedule(l).find(x=>!x.paid) || null; }
+  function scheduleItemStatus(item){
+    if(item.paid) return 'paid';
+    if(item.dueDate){
+      const d=daysUntil(item.dueDate);
+      if(d!==null && d<0) return 'overdue';
+      if(d!==null && d<=7) return 'upcoming';
+    }
+    return 'open';
+  }
+  function renderInstallmentScheduleHtml(l){
+    const schedule=getLoanSchedule(l);
+    if(!schedule.length) return '';
+    const open = schedule.length <= 12 || !!historyOpen['sch_'+l.id];
+    const paid=schedule.filter(x=>x.paid).length;
+    let body='';
+    if(open){
+      body='<div class="installments-list">'+schedule.map(item=>{
+        const st=scheduleItemStatus(item);
+        const statusText=st==='paid' ? `✓ پرداخت‌شده${item.paidAt?' — '+escapeHtml(item.paidAt):''}` : (st==='overdue'?'سررسید گذشته':(st==='upcoming'?'نزدیک سررسید':'در انتظار'));
+        return `<div class="inst-row ${st}">
+          <span class="inst-seq">قسط ${toFa(item.seq)}</span>
+          <span class="mono">${escape